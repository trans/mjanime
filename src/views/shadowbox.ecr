<section class="shadowbox">
  <header class="sb-head">
    <h1><%= MJ::Shadowbox.title %></h1>
    <p class="sb-sub">Compose props &amp; backdrops into a parallax depth-box, then play it.
      <span class="sb-tag">P0 scaffold · three r<span id="sb-rev">?</span> · move the mouse to drift</span></p>
  </header>
  <div id="sb-stage"></div>
</section>

<style>
  .shadowbox{display:flex;flex-direction:column;gap:10px}
  .sb-head h1{margin:0;font-size:20px}
  .sb-sub{margin:0;color:#888;font-size:13px}
  .sb-tag{display:inline-block;margin-left:8px;font:12px ui-monospace,monospace;color:#6ad0ff;opacity:.8}
  #sb-stage{width:100%;height:70vh;min-height:360px;background:#07060a;border:1px solid #222;border-radius:6px;overflow:hidden;cursor:crosshair}
  #sb-stage canvas{display:block}
</style>

<script type="module" src="/js/shadowbox.js"></script>
