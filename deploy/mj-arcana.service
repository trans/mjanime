[Unit]
Description=mj-arcana — mj's camera and voice services on the Arcana bus
Documentation=file://@MJ_DIR@/docs/tools/arcana.md
After=network.target

# The bus (arcana) is not listed as a dependency on purpose: it is not a user unit on
# every host, and mj-arcana does not need it to EXIST at boot — if the bus is down the
# connect fails, the unit restarts, and it joins whenever the bus appears. Restart=always
# plus RestartSec=2 is the whole retry policy.

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mj
ExecStart=@MJ_DIR@/bin/mj-arcana

# Env comes from ONE file generated by cyclops-env, which is the same mechanism the cloud
# servers use — `cyclops-env export <svc> <env>` renders systemd format, the unit reads it
# with EnvironmentFile=. Locally the environment is `local`; on a droplet it is `production`
# and cyclops pushes the file over ssh. Same store, same CLI, same unit shape, so there is
# one way to reason about secrets instead of two.
#
#   just env-pull        # cyclops-env export mj local > ~/.config/mj/env, then restart
#
# Behind it is an encrypted SQLite store (~/.config/cyclops/secrets.db, AES-256-CBC, master
# key 0600), scoped by service x environment. That scoping is why this file holds only
# RUNWARE_API_KEY and OPENAI_API_KEY: mj gets what mj needs, not every credential on the
# machine. A plain shared file had been handing it ANTHROPIC_API_KEY, which mj never uses.
#
# Three ways a key that "is set" is still invisible here, all verified:
#   - a bash .env cannot be an EnvironmentFile: `export KEY=value` is logged as "Ignoring
#     invalid environment assignment" and the variable is left UNSET.
#   - fish universal variables (`set -Ux`) never reach systemd at all.
#   - ~/.config/environment.d works but is inherited by EVERY user unit — measured here,
#     that put provider keys in ~60 processes including the whole GNOME session.
# `just keys` reports what this unit actually sees, read from /proc/<pid>/environ.
#
# Not `-` prefixed: if the file is missing, fail loudly rather than start a service that
# can register nothing.
EnvironmentFile=%h/.config/mj/env

Restart=always
RestartSec=2

# --- sandbox -----------------------------------------------------------------
# It needs very little: the bus over loopback, the provider APIs over TLS, and one
# directory of its own. Any bus participant can send it a request, so it is held to that
# (the security review, 2026-10-21; `systemd-analyze --user security mj-arcana` scores it).
# Never add MemoryDenyWriteExecute= or ProcSubset=pid: they break Crystal's regex JIT and
# its GC (server/mj-arcana.service says how).
NoNewPrivileges=true
# Covers the short-lived temp files: the GIMP scratch dir for `format: "xcf"` and the
# probe file ffprobe measures audio duration from.
PrivateTmp=true
ProtectSystem=strict

# The home directory is an empty tmpfs, with only what the service uses bound back in.
# Read-only was not enough: it left every file the user can read readable, the keys in
# ~/.config/mj/env and ~/.ssh included, and the checkout's .env and .ai/arcana.token.
ProtectHome=tmpfs
# The binary, and nothing else of the checkout.
BindReadOnlyPaths=@MJ_DIR@/bin
# Every billed call is appended to the spend ledger ($XDG_DATA_HOME/mj/spend.jsonl), and
# output_path writes under mj/out, so this is the one place it must be able to write.
# Without it, every generation fails AFTER the provider has already charged you.
BindPaths=%h/.local/share/mj
# `format: "xcf"` shells out to gimp-console, which insists on writing its own config and
# cache. The `-` prefix tolerates their absence, so a host without GIMP still starts.
BindPaths=-%h/.config/GIMP
BindPaths=-%h/.cache/GIMP
# The user's runtime directory holds the session bus and the user manager's own socket,
# through which a compromised process could ask systemd to start an unsandboxed one.
# `-` because the namespace may not show it at all, which is as good.
InaccessiblePaths=-%t

# NOTE on `output_path`: callers write only inside ~/.local/share/mj/out (OutputPath in
# src/arcana/output_path.cr), whatever this unit allows.

UMask=0077
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
# @system-service alone: GIMP's plug-ins need calls in @privileged (capset, fchown;
# tested 2026-10-22), and `format: "xcf"` dies without them. A call outside it fails
# with EPERM rather than killing the process.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# A flood of queued requests is held to this rather than taking the machine with it.
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=default.target
